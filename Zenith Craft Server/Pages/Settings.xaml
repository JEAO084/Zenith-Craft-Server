<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Zenith_Craft_Server.Pages.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="10" Spacing="10">

            <dev:SettingsCard Description="Cambiar el tema de Zenith Craft Server" Header="Tema">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;"/>
                </dev:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="selectTheme"
                    Width="200"
                    SelectionChanged="selectTheme_SelectionChanged">
                    <x:String>Oscuro</x:String>
                    <x:String>Por Defecto</x:String>
                    <x:String>Claro</x:String>
                </ComboBox>
            </dev:SettingsCard>
            <dev:SettingsCard Description="Cambiar Visualmente Zenith Craft Server" Header="Tipo de Fondo">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;" />
                </dev:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="selectBackdrop"
                    Width="200"
                    SelectionChanged="selectBackdrop_SelectionChanged">
                    <x:String>Mica</x:String>
                    <x:String>Mica Alt</x:String>
                    <x:String>Acrylic</x:String>
                    <x:String>Acrilic Thin</x:String>
                    <x:String>Transparent</x:String>
                </ComboBox>
            </dev:SettingsCard>
        </StackPanel>
    </Grid>
</Page>
