<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Zenith_Craft_Server.Pages.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="10" Spacing="10">

            <dev:SettingsCard Description="Cambiar el tema de Zenith Craft Server" Header="Tema">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;" />
                </dev:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="selectTheme"
                    Width="200"
                    SelectionChanged="selectTheme_SelectionChanged">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Claro" Tag="Light" />
                        <ComboBoxItem Content="Oscuro" Tag="Dark" />
                        <ComboBoxItem Content="Por Defecto" Tag="Default" />
                    </ComboBox.Items>
                </ComboBox>
            </dev:SettingsCard>
            <dev:SettingsCard Description="Cambiar Visualmente Zenith Craft Server" Header="Tipo de Fondo">
                <dev:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE91B;" />
                </dev:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="selectBackdrop"
                    Width="200"
                    SelectionChanged="selectBackdrop_SelectionChanged">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem Content="Acrilic Thin" Tag="AcrylicThin" />
                        <ComboBoxItem Content="Transparent" Tag="Transparent" />
                    </ComboBox.Items>
                </ComboBox>
            </dev:SettingsCard>
        </StackPanel>
    </Grid>
</Page>