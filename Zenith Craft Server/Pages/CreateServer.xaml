<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Zenith_Craft_Server.Pages.CreateServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid Margin="10" CornerRadius="10">
        <ScrollView>
            <dev:SettingsGroup Description="Seleccionas las opciones segun te sean necesarias" Header="Crear un Servidor de Minecraft">
                <dev:SettingsGroup.Items>
                    <dev:SettingsExpander
                        Description="Cambia a tu gusto el Nombre, MOTD y Imagen del servidor"
                        Header="Personalizacion"
                        IsExpanded="True">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Imagen / Vista Previa">
                                <StackPanel Orientation="Horizontal">
                                    <Button Background="#05000000">
                                        <Rectangle Width="100" Height="100">
                                            <Rectangle.Fill>
                                                <ImageBrush />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock
                                            Width="400"
                                            Margin="10,5,0,0"
                                            FontSize="28"
                                            Text="{x:Bind NameServerBox.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Width="400"
                                            Margin="10,0,0,0"
                                            FontSize="22"
                                            Text="{x:Bind MOTDServerBox.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="Nombre" Description="El Nombre es Local y no Aparecera en la pantalla de Multijugador en Minecraft.">
                                <TextBox
                                    x:Name="NameServerBox"
                                    MinWidth="200"
                                    MaxLength="75" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="MOTD" Description="Maximo 2 lineas y - de 60 Caracteres, o Puede fallar.">
                                <TextBox
                                    x:Name="MOTDServerBox"
                                    MinWidth="200"
                                    AcceptsReturn="True"
                                    MaxLength="60"
                                    TextWrapping="Wrap" />
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                    <dev:SettingsExpander Description="Selecciona la version Base de Minecraft y luego sus Loaders" Header="Version Base">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <ComboBox MinWidth="200" SelectedIndex="0">
                            <ComboBox.Items>
                                <!--  Aqui deben estar Todas Las Versiones, por ahora solo me enfocare en Minecraft, dps mas adelante en otros juegos o incluso Apps  -->
                                <ComboBoxItem Content="Loading Versions" ToolTipService.ToolTip="Por Ahora no esta en funcionamiento" />
                            </ComboBox.Items>
                        </ComboBox>

                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Loader">
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--  Aqui deben estar Todos los Loaders Disponible para la version seleccionada, Ahora q lo pienso lo hare local aunq solo a una version, mas adelante lo hare de manera Remota descargando listas y archivos  -->
                                        <ComboBoxItem Content="Paper" ToolTipService.ToolTip="Por Ahora no esta en funcionamiento" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="Version del loader">
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--  Aqui deben estar Todos los Loaders Disponible para la version seleccionada, Ahora q lo pienso lo hare local aunq solo a una version, mas adelante lo hare de manera Remota descargando listas y archivos  -->
                                        <ComboBoxItem Content="26.3.-.-" ToolTipService.ToolTip="Por Ahora no esta en funcionamiento" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                    <dev:SettingsExpander Description="Configuracion Inicial para el Servidor" Header="Configuraciones Basicas">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <!--Pre Ajustes-->
                        <ComboBox MinWidth="200" SelectedIndex="0">
                            <ComboBox.Items>
                                <ComboBoxItem Content="Conf. Alta" ToolTipService.ToolTip="Establece un 75% de los recursos" />
                                <ComboBoxItem Content="Conf. Media" ToolTipService.ToolTip="Establece un 50% de los recursos" />
                                <ComboBoxItem Content="Conf. Baja" ToolTipService.ToolTip="Establece un 25% de los recursos" />
                            </ComboBox.Items>
                        </ComboBox>

                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="RAM">
                                <ComboBox IsEditable="True" MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--Aqui deberian de aparecer en 2GB en 2GB la Cantidad de RAM, 1, 2, 4, 6...-->
                                        <ComboBoxItem Content="1"/>
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="Hilos del CPU">
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--Aqui deberian de aparecer en 2 en 2 los Hilos del CPU iniciando con 1, 2, 4, 6...-->
                                        <ComboBoxItem Content="1" ToolTipService.ToolTip="" />
                                        <ComboBoxItem Content="2" ToolTipService.ToolTip="" />
                                        <ComboBoxItem Content="4" ToolTipService.ToolTip="" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                </dev:SettingsGroup.Items>
            </dev:SettingsGroup>
        </ScrollView>
    </Grid>
</Page>
