<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Zenith_Craft_Server.Pages.CreateServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="10" CornerRadius="10">
        <ScrollView>
            <dev:SettingsGroup Description="Seleccionas las opciones segun te sean necesarias" Header="Crear un Servidor de Minecraft">
                <dev:SettingsGroup.Items>
                    <dev:SettingsExpander
                        Description="Cambia a tu gusto el Nombre, MOTD y Imagen del servidor"
                        Header="Personalizacion"
                        IsExpanded="True">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Imagen / Vista Previa">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="100"
                                        Height="100"
                                        Background="#05000000">
                                        <Rectangle
                                            Width="100"
                                            Height="100"
                                            Margin="-12,-6">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="/Assets/Square150x150Logo.png" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock
                                            Width="400"
                                            Margin="10,-6,0,0"
                                            FontSize="32"
                                            Text="{x:Bind NameServerBox.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Width="400"
                                            Margin="10,0,0,0"
                                            FontSize="26"
                                            Text="{x:Bind MOTDServerBox.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="El Nombre es Local y no Aparecera en la pantalla de Multijugador en Minecraft." Header="Nombre">
                                <TextBox
                                    x:Name="NameServerBox"
                                    MinWidth="200"
                                    MaxLength="75" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Maximo 2 lineas y - de 60 Caracteres, o Puede fallar." Header="MOTD">
                                <TextBox
                                    x:Name="MOTDServerBox"
                                    MinWidth="200"
                                    AcceptsReturn="True"
                                    MaxLength="60"
                                    TextWrapping="Wrap" />
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                    <dev:SettingsExpander
                        Description="Selecciona la version Base de Minecraft y luego sus Loaders"
                        Header="Version Base"
                        IsExpanded="True">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE7FC;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <ComboBox MinWidth="200" SelectedIndex="0">
                            <ComboBox.Items>
                                <!--  Aqui deben estar Todas Las Versiones, por ahora solo me enfocare en Minecraft, dps mas adelante en otros juegos o incluso Apps  -->
                                <ComboBoxItem Content="Loading Versions" ToolTipService.ToolTip="Por Ahora no esta en funcionamiento" />
                            </ComboBox.Items>
                        </ComboBox>

                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Loader">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEA86;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--  Aqui deben estar Todos los Loaders Disponible para la version seleccionada, Ahora q lo pienso lo hare local aunq solo a una version, mas adelante lo hare de manera Remota descargando listas y archivos  -->
                                        <ComboBoxItem Content="Paper" ToolTipService.ToolTip="Por Ahora no esta en funcionamiento" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="Version del loader">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xF2C7;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--  Aqui deben estar Todos los Loaders Disponible para la version seleccionada, Ahora q lo pienso lo hare local aunq solo a una version, mas adelante lo hare de manera Remota descargando listas y archivos  -->
                                        <ComboBoxItem Content="26.3.-.-" ToolTipService.ToolTip="Por Ahora no esta en funcionamiento" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                    <dev:SettingsExpander Description="Configuracion Inicial para el Servidor" Header="Configuraciones Basicas">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE90F;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Description="Establece la Cantidad de Jugadores Maximo" Header="Max Player">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEAD4;" />
                                </dev:SettingsCard.HeaderIcon>
                                <NumberBox
                                    MinWidth="200"
                                    Minimum="1"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    Value="20" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece el Puerto del Servidor" Header="Puerto">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE839;" />
                                </dev:SettingsCard.HeaderIcon>
                                <NumberBox
                                    MinWidth="200"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="12345" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece el Nivel de Dificultad del Servidor" Header="Dificultad">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEEA1;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="200" SelectedIndex="2">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="Pacifico" Tag="peaceful"/>
                                        <ComboBoxItem Content="Facil" Tag="easy"/>
                                        <ComboBoxItem Content="Normal" Tag="normal"/>
                                        <ComboBoxItem Content="Dificil" Tag="hard"/>
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                    <dev:SettingsExpander Description="Configuracion Inicial para el Servidor" Header="Configuraciones Avanzadas">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <!--  Pre Ajustes  -->
                        <ComboBox MinWidth="200" SelectedIndex="0">
                            <ComboBox.Items>
                                <ComboBoxItem Content="Conf. Alta" ToolTipService.ToolTip="Establece un 75% de los recursos" />
                                <ComboBoxItem Content="Conf. Media" ToolTipService.ToolTip="Establece un 50% de los recursos" />
                                <ComboBoxItem Content="Conf. Baja" ToolTipService.ToolTip="Establece un 25% de los recursos" />
                            </ComboBox.Items>
                        </ComboBox>

                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Description="Establece la Cantidad de Ram que usara el Servidor en GB" Header="RAM">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEEA0;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox
                                    MinWidth="200"
                                    IsEditable="True"
                                    SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--  Aqui deberian de aparecer en 2GB en 2GB la Cantidad de RAM, 1, 2, 4, 6...  -->
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="6" />
                                        <ComboBoxItem Content="8" />
                                        <ComboBoxItem Content="10" />
                                        <ComboBoxItem Content="12" />
                                        <ComboBoxItem Content="14" />
                                        <ComboBoxItem Content="16" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece la Cantidad de Hilos del CPU que usara el servidor" Header="Hilos del CPU">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEEA1;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <!--  Aqui deberian de aparecer en 2 en 2 los Hilos del CPU iniciando con 1, 2, 4, 6...  -->
                                        <ComboBoxItem Content="1" ToolTipService.ToolTip="" />
                                        <ComboBoxItem Content="2" ToolTipService.ToolTip="" />
                                        <ComboBoxItem Content="4" ToolTipService.ToolTip="" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece el Java que usara el servidor" Header="Java">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE9F5;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox MinWidth="200" SelectedIndex="0">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="Java 8" ToolTipService.ToolTip="" />
                                        <ComboBoxItem Content="Java 16" ToolTipService.ToolTip="" />
                                        <ComboBoxItem Content="Java 21" ToolTipService.ToolTip="" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                </dev:SettingsGroup.Items>
            </dev:SettingsGroup>
        </ScrollView>
    </Grid>
</Page>
