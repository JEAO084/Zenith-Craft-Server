<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Zenith_Craft_Server.Pages.CreateServer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Margin="10" CornerRadius="10">
        <ScrollView>
            <dev:SettingsGroup Description="Seleccionas las opciones segun te sean necesarias" Header="Crear un Servidor de Minecraft">
                <dev:SettingsGroup.Items>
                    <dev:SettingsExpander
                        Description="Cambia a tu gusto el Nombre, MOTD y Imagen del servidor"
                        Header="Personalizacion"
                        IsExpanded="True">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE91B;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Imagen / Vista Previa">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Botón para seleccionar icono personalizado del servidor -->
                                    <Button
                                        x:Name="SelectIconButton"
                                        Width="100"
                                        Height="100"
                                        Background="#05000000"
                                        Click="SelectIconButton_Click"
                                        ToolTipService.ToolTip="Haz clic para seleccionar un icono para el servidor (64x64 PNG)">
                                        <Rectangle
                                            Width="100"
                                            Height="100"
                                            Margin="-12,-6">
                                            <Rectangle.Fill>
                                                <ImageBrush x:Name="ServerIconPreview" ImageSource="/Assets/Square150x150Logo.png" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock
                                            Width="400"
                                            Margin="10,-6,0,0"
                                            FontSize="32"
                                            Text="{x:Bind NameServerBox.Text, Mode=OneWay}" />
                                        <TextBlock
                                            Width="400"
                                            Margin="10,0,0,0"
                                            FontSize="26"
                                            Text="{x:Bind MOTDServerBox.Text, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="El Nombre es Local y no Aparecera en la pantalla de Multijugador en Minecraft." Header="Nombre">
                                <TextBox
                                    x:Name="NameServerBox"
                                    MinWidth="200"
                                    MaxLength="75"
                                    Text="Zenith Server" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Maximo 2 lineas y - de 60 Caracteres, o Puede fallar." Header="MOTD">
                                <TextBox
                                    x:Name="MOTDServerBox"
                                    MinWidth="200"
                                    AcceptsReturn="True"
                                    MaxLength="60"
                                    Text="Un servidor de Zenith Craft"
                                    TextWrapping="Wrap" />
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>

                    <dev:SettingsExpander
                        Description="Selecciona la version Base de Minecraft y luego sus Loaders"
                        Header="Version Base"
                        IsExpanded="True">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE7FC;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <!-- Selector de versión base con ToolTip indicando dónde activar betas -->
                        <ComboBox
                            x:Name="BaseVersionComboBox"
                            MinWidth="200"
                            SelectionChanged="BaseVersionComboBox_SelectionChanged"
                            ToolTipService.ToolTip="Muestra las versiones estables (release). Para ver betas y snapshots, actívalas en Ajustes > Mostrar versiones Beta / Snapshots.">
                            <ComboBox.Items>
                                <ComboBoxItem Content="Cargando versiones..." />
                            </ComboBox.Items>
                        </ComboBox>

                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Loader">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEA86;" />
                                </dev:SettingsCard.HeaderIcon>
                                <!-- Selector de Loader compatible (Forge, Fabric, NeoForge, Paper, Spigot, Purpur, SpongeForge) -->
                                <ComboBox
                                    x:Name="LoaderComboBox"
                                    MinWidth="200"
                                    SelectionChanged="LoaderComboBox_SelectionChanged">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="Paper" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="Version del loader">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xF2C7;" />
                                </dev:SettingsCard.HeaderIcon>
                                <!-- Selector de versión del loader con '+' al inicio para la recomendada -->
                                <ComboBox
                                    x:Name="LoaderVersionComboBox"
                                    MinWidth="200">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="Cargando..." />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>

                    <dev:SettingsExpander Description="Configuracion Inicial para el Servidor" Header="Configuraciones Basicas">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE90F;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Description="Establece la Cantidad de Jugadores Maximo" Header="Max Player">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEAD4;" />
                                </dev:SettingsCard.HeaderIcon>
                                <NumberBox
                                    x:Name="MaxPlayersNumberBox"
                                    MinWidth="200"
                                    Minimum="1"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    Value="20" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece el Puerto del Servidor" Header="Puerto">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE839;" />
                                </dev:SettingsCard.HeaderIcon>
                                <NumberBox
                                    x:Name="PortNumberBox"
                                    MinWidth="200"
                                    Minimum="1"
                                    Maximum="65535"
                                    SpinButtonPlacementMode="Inline"
                                    Value="25565" />
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece el Nivel de Dificultad del Servidor" Header="Dificultad">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEEA1;" />
                                </dev:SettingsCard.HeaderIcon>
                                <ComboBox
                                    x:Name="DifficultyComboBox"
                                    MinWidth="200"
                                    SelectedIndex="2">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="Pacifico" Tag="peaceful" />
                                        <ComboBoxItem Content="Facil" Tag="easy" />
                                        <ComboBoxItem Content="Normal" Tag="normal" />
                                        <ComboBoxItem Content="Dificil" Tag="hard" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>

                    <dev:SettingsExpander Description="Configuracion Inicial para el Servidor" Header="Configuraciones Avanzadas">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <!-- Pre Ajustes para cálculo automático de RAM y CPU (75%, 50%, 25%) -->
                        <ComboBox
                            x:Name="PresetComboBox"
                            MinWidth="200"
                            SelectedIndex="1"
                            SelectionChanged="PresetComboBox_SelectionChanged">
                            <ComboBox.Items>
                                <ComboBoxItem Content="Conf. Alta" Tag="75" ToolTipService.ToolTip="Establece un 75% de los recursos disponibles del sistema" />
                                <ComboBoxItem Content="Conf. Media" Tag="50" ToolTipService.ToolTip="Establece un 50% de los recursos disponibles del sistema" />
                                <ComboBoxItem Content="Conf. Baja" Tag="25" ToolTipService.ToolTip="Establece un 25% de los recursos disponibles del sistema" />
                            </ComboBox.Items>
                        </ComboBox>

                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Description="Establece la Cantidad de Ram que usara el Servidor en GB" Header="RAM">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEEA0;" />
                                </dev:SettingsCard.HeaderIcon>
                                <!-- Selector de RAM de 2 en 2 (1, 2, 4, 6, 8, 10, 12, 14, 16...) -->
                                <ComboBox
                                    x:Name="RamComboBox"
                                    MinWidth="200"
                                    IsEditable="True">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="1" Tag="1" />
                                        <ComboBoxItem Content="2" Tag="2" />
                                        <ComboBoxItem Content="4" Tag="4" />
                                        <ComboBoxItem Content="6" Tag="6" />
                                        <ComboBoxItem Content="8" Tag="8" />
                                        <ComboBoxItem Content="10" Tag="10" />
                                        <ComboBoxItem Content="12" Tag="12" />
                                        <ComboBoxItem Content="14" Tag="14" />
                                        <ComboBoxItem Content="16" Tag="16" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece la Cantidad de Hilos del CPU que usara el servidor (controlado por flags de GC y afinidad de proceso)" Header="Hilos del CPU">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xEEA1;" />
                                </dev:SettingsCard.HeaderIcon>
                                <!-- Selector de hilos de 2 en 2 (1, 2, 4, 6, 8...) según núcleos lógicos del sistema -->
                                <ComboBox
                                    x:Name="CpuThreadsComboBox"
                                    MinWidth="200">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="1" Tag="1" />
                                        <ComboBoxItem Content="2" Tag="2" />
                                        <ComboBoxItem Content="4" Tag="4" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Description="Establece el Java que usara el servidor (+ indica la version recomendada para la version de Minecraft y Loader seleccionados)" Header="Java">
                                <dev:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE9F5;" />
                                </dev:SettingsCard.HeaderIcon>
                                <!-- Selector dinámico de versiones de Java con '+' al inicio para la recomendada -->
                                <ComboBox
                                    x:Name="JavaComboBox"
                                    MinWidth="200">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="Java 8" Tag="8" />
                                        <ComboBoxItem Content="Java 16" Tag="16" />
                                        <ComboBoxItem Content="Java 17" Tag="17" />
                                        <ComboBoxItem Content="+ Java 21 (LTS)" Tag="21" />
                                    </ComboBox.Items>
                                </ComboBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>

                    <!-- AGREGADO: Sección de Creación y Notificaciones para el Servidor -->
                    <dev:SettingsExpander Description="Revisa y finaliza la creacion de tu nuevo servidor" Header="Crear Servidor" IsExpanded="True">
                        <dev:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE710;" />
                        </dev:SettingsExpander.HeaderIcon>
                        <Button
                            x:Name="CreateServerButton"
                            HorizontalAlignment="Right"
                            Click="CreateServerButton_Click"
                            Content="Crear Servidor"
                            Style="{StaticResource AccentButtonStyle}" />
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard>
                                <StackPanel Spacing="10">
                                    <ProgressBar x:Name="OperationProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                                    <InfoBar
                                        x:Name="ServerStatusInfoBar"
                                        IsOpen="False"
                                        IsClosable="True" />
                                </StackPanel>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                </dev:SettingsGroup.Items>
            </dev:SettingsGroup>
        </ScrollView>
    </Grid>
</Page>
