<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Zenith_Craft_Server.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid>
        <Grid VerticalAlignment="Center">
            <StackPanel>

                <TextBlock HorizontalAlignment="Center" Text="Crea tu Primer servidor" Padding="10"/>
                <Button
                    x:Name="CreateSerber"
                    Padding="20"
                    HorizontalAlignment="Center"
                    Content="Crear SERVER"
                    FontSize="20" 
                    Click="CreateSerber_Click"  />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
