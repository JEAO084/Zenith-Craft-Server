<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Zenith_Craft_Server.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:local="using:Zenith_Craft_Server"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Zenith Craft Server"
    mc:Ignorable="d" Closed="MainWindow_Closed">
    <Grid x:Name="rootWindows">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <!--  TitleBar  -->
                <RowDefinition Height="*" />
                <!--  NavigationView  -->
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="titleBar"
                Title="Zenith Craft Server"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="titleBar_PaneToggleRequested"
                Subtitle="Beta">
                <TitleBar.Resources>
                    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                </TitleBar.Resources>
                <TitleBar.RightHeader>
                    <Grid>
                        <PersonPicture
                            Width="25"
                            Height="25"
                            Margin="3"
                            HorizontalAlignment="Left"
                            Initials="ST" />
                        <SplitButton
                            x:Name="serverSelect"
                            Width="200"
                            Height="30"
                            Padding="30,-2,0,0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Click="serverSelect_Click"
                            Content="Server Test">
                            <SplitButton.Flyout>
                                <Flyout>
                                    <Grid Width="167" Height="auto" />
                                </Flyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </Grid>
                </TitleBar.RightHeader>
            </TitleBar>

            <NavigationView
                x:Name="navView"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="False"
                IsPaneToggleButtonVisible="False"
                PaneDisplayMode="LeftCompact"
                SelectionChanged="navView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Inicio"
                        Icon="Home"
                        Tag="Home" />
                </NavigationView.MenuItems>
                <Frame x:Name="viewPages" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>